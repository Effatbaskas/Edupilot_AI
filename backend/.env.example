DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004
LLM_MODEL=gemini-1.5-flash
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=app/storage/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required by Docker Compose. Use unique values and keep this file private.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# AI provider mode: mock requires no API key; switch to gemini only when configured.
AI_MODE=mock
